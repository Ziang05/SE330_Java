    @Setter
    @NoArgsConstructor
    @AllArgsConstructor
    public static class DailySummary {

        /**
         * Ngày thống kê.
         */
        private LocalDate date;

        /**
         * Tổng tiền thu về trong ngày (paid_amount).
         */
        private BigDecimal revenue;

        /**
         * Số lượt khám (hóa đơn PAID) trong ngày.
         */
